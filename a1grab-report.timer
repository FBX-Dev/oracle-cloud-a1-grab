[Unit]
Description=Generate OCI A1 grab report and push summary daily at 08:00

[Timer]
# 早上 8 点生成昨天日报并推微信：半夜推送没人看，早上正好一眼扫过。
# 想改时间只改这一行，例如 00:05:00 / 09:30:00。
OnCalendar=*-*-* 08:00:00
# 机器关机/休眠错过时间点，开机后补跑一次
Persistent=true
# 加一点随机偏移，避免整点与其它任务撞车
RandomizedDelaySec=120
Unit=a1grab-report.service

[Install]
WantedBy=timers.target
